# === Build Artifacts (C/C++) ===
# Compiled objects
*.o
*.obj
*.lo
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Executables (if you build in the root dir)
# If you only build to ./bin, you can ignore that folder entirely below
org2md
md2org

# Build directories
/bin/
/build/
/dist/
/out/
/cmake-build-*/

# === Debugging & Profiling ===
*.gch        # Precompiled headers
*.pch
core         # Core dumps
core.*
*.stackdump
vgcore.*     # Valgrind core dumps
callgrind.*
cachegrind.*

# === Dependency Managers / Configs ===
# Meson
/builddir/
/subprojects/

# CMake (usually you don't ignore these, but if you want a clean repo)
# CMakeLists.txt.user
# CMakeCache.txt
# CMakeFiles/
# Makefile

# === Editors & IDEs ===
# Vim
*.swp
*.swo
*~

# Emacs (Temporary and Auto-save files)
*~
\#*\#
.\#*
*.eln
/auto/
/.emacs.desktop
/.emacs.desktop.lock

# VS Code (if you don't want to commit workspace settings)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# CLion / JetBrains
.idea/

# === OS Generated Files ===
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.directory
.Trash-*

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

.gdb_history